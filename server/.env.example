# Copiar a server/.env y completar. server/.env NUNCA se versiona (ver .gitignore).

# Cadena de conexión de PostgreSQL 16 local. Crear la BD antes de migrar:
#   CREATE DATABASE sistema_gaby;
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/sistema_gaby?schema=public"

PORT=3000
NODE_ENV=development

# Origen permitido por CORS. En dev es el puerto de Vite; en producción de un
# solo puerto (ver docs/16-guia-migracion.md) puede ser el mismo host:puerto
# donde corre este server, o dejarse igual si el navegador siempre entra por
# la misma URL que sirve la API.
CORS_ORIGIN=http://localhost:5173

# Secretos JWT — mínimo 32 caracteres cada uno, DISTINTOS entre sí y por entorno.
# Generar uno nuevo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_aleatorio_de_al_menos_32_caracteres
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_aleatorio_de_al_menos_32_caracteres
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Carpetas de archivos generados, relativas a server/ (se crean solas si no existen).
UPLOADS_DIR=../uploads
BACKUPS_DIR=../backups

# Carpeta bin de la instalación de PostgreSQL (para pg_dump/psql — Fase 13,
# respaldos). Opcional: si se omite, se busca pg_dump/psql en el PATH del
# sistema. En Windows suele ser algo como:
PG_BIN="C:\Program Files\PostgreSQL\16\bin"

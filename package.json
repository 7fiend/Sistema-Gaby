{
  "name": "sistema-gaby",
  "version": "0.1.0",
  "private": true,
  "description": "ERP local para restaurante: producción, recetas, costos, inventario con báscula, cocina y reportes",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w shared --if-present && npm run build -w server --if-present && npm run build -w client --if-present",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:studio": "npm run db:studio -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w server",
    "test:e2e": "tsx scripts/run-e2e.mts"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
